  "visualCoverage": {
    "attempts": {},
    "expected": {
      "approvedRevision": 3,
      "blueprintId": "gbp_d87d65950d14933211392229",
      "digest": "5717fbf3951bb147febeb60455a73793b025d1d39b447da5041cdeb6b20808bc",
      "roles": [
        {
          "description": "Create your twelve distinct side-view cartoon fighters, keeping the eight CSM Gang characters exclusive to Player 1 and the four Opposite Gang characters exclusive to Player 2 or CPU. Each fighter needs exaggerated proportions, unique clothing and colors, a replaceable face-card area, and readable idle, walk, punch, kick, jump, block, hit, victory, defeat, and signature-special animation states.",
          "id": "fighter_roster",
          "label": "Complete 12-fighter roster"
        },
        {
          "description": "Give each of your twelve fighters a visually distinct signature attack matching its recorded name, with readable anticipation, impact, and recovery while preserving the shared 25-damage gameplay rule.",
          "id": "signature_attacks",
          "label": "Character-specific special attacks"
        },
        {
          "description": "Provide your combat stage with a readable side-view floor, collision boundaries, enough contrast for both teams, and a dark collegiate arcade atmosphere using restrained neon cyan, pink, and purple accents.",
          "id": "battle_arena",
          "label": "Side-view battle arena"
        },
        {
          "description": "Cover your punches, kicks, blocks, jumps, knockback, hit reactions, low-health state, specials, victories, and defeats with lightweight 2D impact flashes, particles, motion accents, and clear feedback suitable for smooth 60 FPS play.",
          "id": "combat_vfx",
          "label": "Combat effects and hit feedback"
        },
        {
          "description": "Create your roster and collection cards with team separation, recognizable fighter silhouettes, placeholder face areas, and framing that supports in-memory photo preview, crop, positioning, apply, replace, and removal without uploading or persisting personal images.",
          "id": "fighter_cards",
          "label": "Selection and customizable face cards"
        },
        {
          "description": "Design your glowing health bars, special meters, round wins, 60-second timer, pause affordance, dialogue display, and responsive touch controls so they remain readable without obscuring the fighters.",
          "id": "fight_hud",
          "label": "Fight HUD and mobile controls"
        },
        {
          "description": "Cover your arcade VS presentation, dramatic fight countdown, round transitions, victory and defeat presentation, results, restart, and rematch flow with smooth neon arcade motion.",
          "id": "versus_flow",
          "label": "VS screen, countdown, and match outcomes"
        },
        {
          "description": "Provide your landing menu, character selection, mode and AI difficulty selection, customization, instructions, settings, pause, and collection screens in a cohesive polished arcade style rather than an admin-dashboard layout.",
          "id": "menu_shell",
          "label": "Arcade menus and mode selection"
        }
      ]
    },
    "overflowEvents": 0,
